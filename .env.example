# ── Required in production ─────────────────────────────────────────────
# Database (Supabase: Project Settings -> API). Only the SERVER uses these.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# The single access code you type once on your phone. Choose something long.
APP_PASSCODE=
# Signs the login cookie and assessment tokens (any long random string).
ASSESSMENT_SECRET=

# ── Optional ───────────────────────────────────────────────────────────
APP_USER_NAME=Läraren
# AI tutor (server only). The app works without it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
